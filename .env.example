# ---------------------------------------------------------------------------
# Hamzonics configuration. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# dev | prod | test
ENV=prod
APP_NAME=Hamzonics
# Public URL of the site (printed in reports and QR codes)
PUBLIC_BASE_URL=https://check.example.com
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# --- Public site limits --------------------------------------------------------
# Checks processed at the same time; everyone else waits in the queue (first come, first served)
MAX_CONCURRENT_CHECKS=3
# New uploads are refused while this many are waiting
MAX_QUEUE=200
# Per visitor (IP address); 0 = no limit
CHECKS_PER_IP_PER_HOUR=20
# Checks are deleted after N days (0 = keep forever)
RETENTION_DAYS=30
# CPU threads per check for the AI model (keep 1-2 when 3 checks run at once)
BLAS_THREADS=1

# --- Database / queue -------------------------------------------------------
POSTGRES_USER=hamzonics
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hamzonics
DATABASE_URL=postgresql+psycopg://hamzonics:CHANGE_ME@postgres:5432/hamzonics
REDIS_URL=redis://redis:6379/0
# celery (production, needs Redis) | inline (local without Redis)
JOB_RUNNER=celery
JOB_TIME_LIMIT_S=1800

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=/data/uploads
REPORT_DIR=/data/reports
REPORT_TIMEZONE=Asia/Karachi
GENERATE_PDF_IN_PIPELINE=true
MAX_UPLOAD_MB=25
MAX_WORDS=50000

# --- Extraction / OCR --------------------------------------------------------
OCR_LANGUAGES=eng+urd
OCR_MIN_CHARS_PER_PAGE=25
OCR_DPI=300
# pdfplumber (MIT, default) | pymupdf (AGPL-3.0, see THIRD_PARTY.md)
PDF_BACKEND=pdfplumber
ENABLE_PYMUPDF=false

# --- Similarity --------------------------------------------------------------
ENABLE_SEMANTIC=true
SIMILARITY_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
SEMANTIC_THRESHOLD=0.85
TORCH_THREADS=1
MAX_CANDIDATE_SOURCES=80
# The report leaves the bibliography out of the score by default
DEFAULT_EXCLUDE_BIBLIOGRAPHY=true
# Matches shorter than this many words are left out of the score by default (common phrases)
DEFAULT_MIN_WORDS=8

# Sources (free): wikipedia, arxiv, europepmc, openalex, crossref, semanticscholar, core
FREE_SOURCES=
WIKIPEDIA_LANGS=en,ur
# Optional FREE keys that raise daily limits (register on each site):
OPENALEX_API_KEY=
SEMANTICSCHOLAR_API_KEY=
# CORE (core.ac.uk) full text of 30M+ open-access papers; add "core" to FREE_SOURCES too
CORE_API_KEY=
# Web search for Internet sources.
# RECOMMENDED: serper.dev (Google results, ~$1 per 1,000 searches, 2,500 free at sign-up, no card).
# Free search engines (SearXNG below) block heavy use; a paid key does not get blocked.
SERPER_API_KEY=
# Searches per check sent to paid APIs (12 = about $0.012 per check with Serper)
PAID_SEARCH_MAX_QUERIES=12
# docker-compose also runs a free SearXNG for the worker (used in addition):
SEARXNG_SECRET=CHANGE_ME
# Optional paid/limited web search APIs (used in addition to SearXNG when set):
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
WEB_SEARCH_MAX_QUERIES=24
WEB_RESULTS_PER_QUERY=4
WEB_MAX_PAGES=100
WEB_CACHE_DAYS=90
WEB_FETCH_PDFS=true

# --- AI-writing detection (no PyTorch needed) ----------------------------------
ENABLE_AI=true
AI_MODEL=fakespot-ai/roberta-base-ai-text-detection-v1
AI_MODEL_REVISION=f9cdb14d1f8b105f597d80fa7b56f20c6ea0e9db
# Sentences scoring >= AI_THRESHOLD count as AI; between the two are shown as "possibly AI"
AI_THRESHOLD=0.995
AI_POSSIBLE_THRESHOLD=0.9
AI_MIN_WORDS=300
# Confirming detector (PyTorch, in the Docker image): a window is AI only if both models agree.
# Removes the first model's false alarms on human text. Without it the stricter threshold applies.
AI_CONFIRM_ENABLED=true
AI_CONFIRM_THRESHOLD=0.72
AI_THRESHOLD_UNCONFIRMED=0.9997
# Second detector (DeskLib DeBERTa-v3-large, in the Docker image). Off by default: needs ~1.7 GB RAM,
# or ~0.8 GB with AI2_QUANTIZE=true (int8). AI2_RULE: max (catches more) | mean | min (fewer alarms).
AI2_ENABLED=false
AI2_QUANTIZE=false
AI2_RULE=max

# --- Admin portal (/admin): manage search API keys. Empty = portal off. -----------
ADMIN_PASSWORD=
